# Postgres. On Vercel these are set in the project's Environment Variables, not in a file.
#
# DATABASE_URL must be the POOLED endpoint. Serverless opens a connection per function
# instance, and an unpooled Postgres runs out of connections quickly.
#
# Supabase: Project Settings -> Database -> Connection string.
#   pooled  = "Transaction pooler", port 6543  -> DATABASE_URL
#   schema  = "Session pooler",     port 5432  -> DIRECT_URL
#   Append ?pgbouncer=true&connection_limit=1 to the pooled one. `pgbouncer=true` turns off
#   prepared statements, which a transaction pooler cannot support; without it you get
#   intermittent "prepared statement already exists" errors under load.
#
#   Use the SESSION pooler for DIRECT_URL, not the "Direct connection" host. The direct host
#   (db.<ref>.supabase.co) resolves to IPv6 only, and from a network without a working IPv6
#   route `prisma db push` fails. The session pooler is IPv4 and passes schema changes through.
#   Its username is postgres.<project-ref>, the same as the transaction pooler's.
#
# Neon: the dashboard labels them "Pooled connection" and "Direct connection".
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Only used by `prisma db push` / `migrate`, which do things a transaction pooler will not pass
# through. Never used at runtime.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Secret used to sign the login session. CHANGE THIS to a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs you out everywhere, which is the point if it ever leaks.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars-long"

# Bearer token Vercel Cron sends to /api/cron. A different random string from AUTH_SECRET.
CRON_SECRET=""

# Set to "true" when something in front of the app sets x-forwarded-for, which Vercel and
# any normal reverse proxy do. It turns on per-source-address throttling of sign-in.
# Leave unset when running directly with no proxy: the header would be attacker-controlled
# and the limit meaningless.
TRUST_PROXY_HEADER="true"
